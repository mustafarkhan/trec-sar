<?xml version="1.0"?>
<!--
  TREC-SAR tracked UGV. Hull 0.84 x 0.42 x 0.20 m and 80 kg — the TREC (NUST/EME)
  spec sheet. Tracks are simulated as three wheels per side (skid steer); the
  track belts are visual only. This is the standard trade-off for Gazebo, where
  true track contact is slow and unstable.

  Reconfigurable payload bay (TREC idea): camera/thermal mast, lidar, and a
  relay-node dropper replace the original gun mount / mine detector / arm.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="trecsar">
  <xacro:property name="L" value="0.84"/>
  <xacro:property name="W" value="0.42"/>
  <xacro:property name="H" value="0.20"/>
  <xacro:property name="mass" value="80.0"/>
  <xacro:property name="wheel_r" value="0.10"/>
  <xacro:property name="wheel_w" value="0.08"/>
  <xacro:property name="track_y" value="${W/2 + wheel_w/2 + 0.01}"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <material name="sand"><color rgba="0.82 0.76 0.62 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.10 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_r + 0.02}"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0 0 ${H/2}"/><geometry><box size="${L} ${W} ${H}"/></geometry><material name="sand"/></visual>
    <collision><origin xyz="0 0 ${H/2}"/><geometry><box size="${L} ${W} ${H}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${H/2}"/><mass value="${mass}"/><xacro:box_inertia m="${mass}" x="${L}" y="${W}" z="${H}"/></inertial>
  </link>

  <!-- track belts (visual only) -->
  <xacro:macro name="track_belt" params="side y">
    <link name="${side}_track">
      <visual><geometry><box size="${L + 0.06} ${wheel_w} ${2*wheel_r + 0.02}"/></geometry><material name="black"/></visual>
    </link>
    <joint name="${side}_track_joint" type="fixed">
      <parent link="base_link"/><child link="${side}_track"/><origin xyz="0 ${y} 0"/>
    </joint>
  </xacro:macro>
  <xacro:track_belt side="left" y="${track_y}"/>
  <xacro:track_belt side="right" y="${-track_y}"/>

  <!-- road wheels (physics) -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <inertial><mass value="2.0"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.006"/></inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}">
      <collision><surface><friction><ode><mu>1.2</mu><mu2>0.6</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:wheel name="left_front" x="${L/2 - wheel_r}" y="${track_y}"/>
  <xacro:wheel name="left_mid" x="0" y="${track_y}"/>
  <xacro:wheel name="left_rear" x="${-L/2 + wheel_r}" y="${track_y}"/>
  <xacro:wheel name="right_front" x="${L/2 - wheel_r}" y="${-track_y}"/>
  <xacro:wheel name="right_mid" x="0" y="${-track_y}"/>
  <xacro:wheel name="right_rear" x="${-L/2 + wheel_r}" y="${-track_y}"/>

  <!-- sensor mast: RGB camera + thermal camera -->
  <link name="mast">
    <visual><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.025" length="0.5"/></geometry><material name="black"/></visual>
    <inertial><mass value="1.5"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="mast_joint" type="fixed"><parent link="base_link"/><child link="mast"/><origin xyz="${L/2 - 0.12} 0 ${H}"/></joint>

  <link name="camera_link">
    <visual><geometry><box size="0.06 0.12 0.06"/></geometry><material name="black"/></visual>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="mast"/><child link="camera_link"/><origin xyz="0.03 0 0.52"/></joint>
  <link name="camera_optical"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>

  <link name="thermal_link">
    <visual><geometry><box size="0.05 0.06 0.05"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="thermal_joint" type="fixed"><parent link="mast"/><child link="thermal_link"/><origin xyz="0.03 0 0.44"/></joint>

  <!-- 3D lidar for SLAM / Nav2 -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.05" length="0.07"/></geometry><material name="black"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.05 0 ${H + 0.05}"/></joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.05"/></joint>

  <!-- payload bay: relay dropper (holds up to 4 mesh-radio nodes) -->
  <link name="relay_bay">
    <visual><geometry><box size="0.26 0.30 0.08"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="relay_bay_joint" type="fixed"><parent link="base_link"/><child link="relay_bay"/><origin xyz="${-L/2 + 0.18} 0 ${H + 0.04}"/></joint>

  <!-- ===================== Gazebo (Harmonic) ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_joint</left_joint><left_joint>left_mid_joint</left_joint><left_joint>left_rear_joint</left_joint>
      <right_joint>right_front_joint</right_joint><right_joint>right_mid_joint</right_joint><right_joint>right_rear_joint</right_joint>
      <wheel_separation>${2*track_y}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_velocity>2.22</max_linear_velocity>   <!-- 8 km/h, TREC spec -->
      <max_angular_velocity>1.5</max_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <gz_frame_id>camera_optical</gz_frame_id>
      <update_rate>10</update_rate><topic>/camera/image</topic>
      <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>120</far></clip></camera>
    </sensor>
  </gazebo>

  <gazebo reference="thermal_link">
    <sensor name="thermal_camera" type="thermal_camera">
      <update_rate>9</update_rate><topic>/thermal/image</topic>
      <camera><horizontal_fov>0.9</horizontal_fov><image><width>320</width><height>240</height><format>L16</format></image>
        <clip><near>0.1</near><far>80</far></clip></camera>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate><topic>/scan</topic>
      <lidar>
        <scan><horizontal><samples>720</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.3</min><max>40.0</max></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu"><update_rate>100</update_rate><topic>/imu</topic></sensor>
  </gazebo>
</robot>
